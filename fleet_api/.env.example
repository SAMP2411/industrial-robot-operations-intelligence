INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=replace-with-an-influxdb-api-token
INFLUX_ORG=startup-robot-dashboard
INFLUX_BUCKET=robot_fleet
FLEETWATCH_SQLITE_PATH=./fleet_api/data/fleetwatch.db
FACTORY_BENCHMARK_RUNTIME_ROOT=/home/samarth/.ros/factory_inspection/benchmark
FACTORY_SITE_CONFIG=./src/factory_inspection_mission/config/sites/benchmark_site.yaml
FACTORY_ASSET_REGISTRY=./src/factory_inspection_mission/config/assets/benchmark_asset_registry.yaml
FACTORY_INSPECTION_PROFILES=./src/factory_inspection_mission/config/inspection_profiles/benchmark_inspection_profiles.yaml

SECRET_KEY=replace-with-a-long-random-value
INGEST_API_KEY=replace-with-a-separate-ingestion-key
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional local demo account. Leave DEMO_EMAIL and DEMO_PASSWORD empty to disable it.
DEMO_EMAIL=sam@fleetwatch.io
DEMO_PASSWORD=replace-with-a-demo-password
DEMO_COMPANY=FleetWatch
DEMO_TENANT_ID=tenant_fleetwatch

# Used by robot_sim.py; it must match the account/fleet being simulated.
TENANT_ID=tenant_fleetwatch
