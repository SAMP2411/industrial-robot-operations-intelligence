POSTGRES_DB=incident_intelligence
POSTGRES_USER=rfii
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
RFII_SECRET_KEY=replace-with-at-least-32-random-bytes
RFII_PORT=8000
RFII_DATABASE_URL=postgresql+psycopg://rfii:replace-me@localhost:5432/incident_intelligence
RFII_STORAGE_ROOT=./storage
RFII_MAX_UPLOAD_BYTES=26214400
RFII_CORS_ORIGINS=http://localhost:8000
RFII_AUTH_REQUIRED=true
RFII_TOKEN_EXPIRE_MINUTES=60
RFII_APP_ENV=production

